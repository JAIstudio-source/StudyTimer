<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="DialogScaleAnimation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_scale_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_scale_out</item>
    </style>

    <style name="AmoledPickerDialogTheme" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">#12141C</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#94A3B8</item>
        <item name="android:colorAccent">#6366F1</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/AmoledDialogPositiveButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/AmoledDialogNegativeButton</item>
    </style>

    <style name="AmoledDialogPositiveButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">#6366F1</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AmoledDialogNegativeButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">#94A3B8</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>

