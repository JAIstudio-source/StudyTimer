<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="28dp"
        android:paddingTop="36dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Logo with Subtle Ambient Glow -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_logo_ambient_glow"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:src="@drawable/mylogo"
                android:scaleType="fitCenter"
                android:contentDescription="StudyTimer Logo" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="StudyTimer"
            android:textColor="#FFFFFF"
            android:textSize="29sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Focus, Track &amp; Master Your Habits"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:letterSpacing="0.01"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium" />

        <View
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <!-- Google Sign In Button (Modern Crisp White Pill) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Continue with Google"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="27dp"
            app:backgroundTint="#FFFFFF"
            app:icon="@drawable/ic_google_logo"
            app:iconTint="@null"
            app:iconSize="20dp"
            app:iconPadding="12dp"
            app:iconGravity="textStart"
            app:elevation="2dp" />

        <!-- Recommendation Note -->
        <TextView
            android:id="@+id/tvRecommendation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recommended: Sign in to save your progress, habits, and study analytics across devices."
            android:textColor="#64748B"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="2.5dp"
            android:fontFamily="sans-serif-medium" />

        <!-- Terms & Privacy Notice -->
        <TextView
            android:id="@+id/tvLegalNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="11.5sp"
            android:gravity="center"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:fontFamily="sans-serif-medium" />

        <View
            android:layout_width="match_parent"
            android:layout_height="22dp" />

        <!-- Guest / Skip Button (Secondary Outlined Pill) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuest"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Continue as Guest"
            android:textColor="#CBD5E1"
            android:textSize="13.5sp"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="24dp"
            app:backgroundTint="#00000000"
            app:strokeColor="#334155"
            app:strokeWidth="1dp"
            app:rippleColor="#20FFFFFF" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Footer Copyright & Privacy Badge -->
        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="© Pushkar Studio • 100% Offline &amp; Secure"
            android:textColor="#475569"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

</ScrollView>
