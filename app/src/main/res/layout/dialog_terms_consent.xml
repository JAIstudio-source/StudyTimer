<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_terms_dialog"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#334155"
        android:layout_marginBottom="18dp" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_shield_check"
            android:contentDescription="Security Shield" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terms &amp; Privacy Agreement"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="To sync your study habits, streaks, and rank on leaderboards, please review and accept our terms."
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:gravity="center"
        android:lineSpacingExtra="2.5dp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <!-- Key Highlights Summary Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_terms_card"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Point 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Privacy First: Your personal study logs, goals, and focus timers remain private and protected."
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:lineSpacingExtra="2.5dp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Point 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☁️"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cloud Sync &amp; Backup: Securely syncs your progress and stats across devices with your Google account."
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:lineSpacingExtra="2.5dp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Point 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚖️"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Fair Community: Respectful usernames and fair timer tracking on daily and weekly leaderboards."
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:lineSpacingExtra="2.5dp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <!-- Clickable Links Notice -->
    <TextView
        android:id="@+id/tvDialogLegalLinks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp" />

    <!-- Checkbox Agreement -->
    <CheckBox
        android:id="@+id/cbAcceptTerms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="I have read and agree to the Terms &amp; Privacy Policy"
        android:textColor="#E2E8F0"
        android:textSize="12.5sp"
        android:fontFamily="sans-serif-medium"
        android:checked="true"
        android:buttonTint="#818CF8"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp" />

    <!-- 1. Google Agree Button (Matching Main Login Page Button Style) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAgreeAndContinue"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Agree &amp; Continue with Google"
        android:textColor="#0F172A"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        app:cornerRadius="27dp"
        app:backgroundTint="#FFFFFF"
        app:icon="@drawable/ic_google_logo"
        app:iconTint="@null"
        app:iconSize="20dp"
        app:iconPadding="12dp"
        app:iconGravity="textStart"
        app:elevation="2dp" />

    <!-- 2. Cancel Button (Matching Secondary Button Style) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelConsent"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Cancel"
        android:textColor="#CBD5E1"
        android:textSize="13.5sp"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        app:cornerRadius="24dp"
        app:backgroundTint="#00000000"
        app:strokeColor="#334155"
        app:strokeWidth="1dp"
        app:rippleColor="#20FFFFFF"
        android:layout_marginTop="10dp" />

</LinearLayout>
